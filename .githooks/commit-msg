#!/bin/bash
# commit-msg hook: Enforce conventional commits via speckit workflows

COMMIT_MSG=$(cat "$1")

# Allow if commit message starts with conventional commit type
if echo "$COMMIT_MSG" | grep -qE '^(feat|fix|perf|refactor|chore|docs)(\(.+\))?: ' 2>/dev/null; then
  exit 0
fi

# Allow if automated by speckit env var
if [ -n "$SPECKIT_COMMIT" ] || [ -n "$SPECKIT_WORKFLOW" ]; then
  exit 0
fi

# Reject otherwise
cat >&2 << 'EOF'
❌ Commit blocked: Conventional commits required.

Format: <type>: <description>

Valid types: feat, fix, perf, refactor, chore, docs

Examples:
  feat: Add dark mode toggle to settings
  fix: Resolve race condition in word sync
  refactor: Simplify auth middleware
  chore: Update dependencies

Use speckit skills to make changes:
  /speckit-implement <task>
  /speckit-plan <objective>
  /speckit-specify <requirement>
  /speckit-analyze <question>

EOF
exit 1
