{
  "name": "membetter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "predev": "node scripts/ensure-electron.js",
    "dev": "electron-vite dev",
    "build": "tsc -b && electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "dev:web": "vite",
    "build:web": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir",
    "test:packaged": "PACKAGED_APP=\"$PWD/release/mac-arm64/MemBetter.app/Contents/MacOS/MemBetter\" playwright test packaged",
    "samples": "node scripts/make-sample-library.ts",
    "dev:samples": "node scripts/dev-samples.ts",
    "dev:reset": "node scripts/reset-dev-data.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/github": "^12.0.10",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "semantic-release": "^25.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "main": "out/main/index.js",
  "description": "MemBetter: local-first vocabulary learning",
  "author": "MemBetter"
}
